+});
+
+await page.evaluate((c) => { window.__crosshair = c; }, crosshair);
+const hudLive = await page.evaluate(async () => {
+  const O = window.__OPERATOR__;
+  const sleepFor = (ms) => new Promise((r) => setTimeout(r, ms));
