+    bq.fromArray(quats[seg + 1] as number[]);
+    out.copy(a).slerp(bq, smootherstep(Math.min(1, Math.max(0, localT))));
+    outTimes.push(time);
+    outValues.push(out.x, out.y, out.z, out.w);
+  }
