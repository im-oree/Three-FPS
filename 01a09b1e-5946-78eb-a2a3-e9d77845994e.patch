+  grp.add(cyl(0.11, 0.11, 0.12, 8, COL.rubber,
+    'Gear_MainTyreR', [0.65, 1.18, 0.50], [0, 0, Math.PI / 2]));
+  grp.add(cyl(0.11, 0.11, 0.12, 8, COL.rubber,
