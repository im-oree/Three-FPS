+/**
+ * styles.css — Document 5. One stylesheet for every menu and HUD element.
+ *
+ * Naming is BEM-ish: .block, .block__element, .block--modifier.
+ *
+ * #ui-root is pointer-events:none so gameplay clicks reach the canvas; every
+ * interactive control must opt back in with pointer-events:auto.
+ */
+
+:root {
+  --ui-bg: #0b0d11;
+  --ui-panel: rgba(16, 19, 25, 0.92);
+  --ui-line: rgba(255, 255, 255, 0.14);
+  --ui-text: #e8eaee;
+  --ui-dim: #99a1ad;
+  --ui-accent: #f0a04b;
+  --ui-accent-dim: rgba(240, 160, 75, 0.18);
+  --ui-danger: #d8574b;
+  --ui-good: #6fc98a;
+  --ui-font: 'Segoe UI', system-ui, -apple-system, sans-serif;
+  --ui-mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
+}
+
+#ui-root {
+  position: fixed;
+  inset: 0;
+  pointer-events: none;
+  font-family: var(--ui-font);
+  color: var(--ui-text);
+  z-index: 20;
+  user-select: none;
+}
+
+/* ---------- generic screen ------------------------------------------------ */
+
+.screen {
+  position: absolute;
+  inset: 0;
+  display: none;
+  pointer-events: auto;
+  background: radial-gradient(ellipse at 50% 35%, #1b2028 0%, var(--ui-bg) 70%);
+}
+.screen--active { display: flex; }
+.screen--overlay { background: rgba(6, 8, 11, 0.72); backdrop-filter: blur(6px); }
+.screen--transparent { background: none; pointer-events: none; }
+
+.screen__inner {
+  margin: auto;
+  width: min(960px, 90vw);
+  display: flex;
+  flex-direction: column;
+  gap: 22px;
+}
+
+/* ---------- typography ---------------------------------------------------- */
+
+.title {
+  font-size: clamp(34px, 6vw, 68px);
+  font-weight: 800;
+  letter-spacing: 0.22em;
+  margin: 0;
+  text-transform: uppercase;
+}
+.title__mark { color: var(--ui-accent); }
+.subtitle {
+  margin: 0;
+  color: var(--ui-dim);
+  letter-spacing: 0.28em;
+  font-size: 12px;
+  text-transform: uppercase;
+}
+.section-heading {
+  font-size: 13px;
+  letter-spacing: 0.2em;
+  text-transform: uppercase;
+  color: var(--ui-dim);
+  margin: 0 0 10px;
+}
+
+/* ---------- buttons ------------------------------------------------------- */
+
+.btn {
+  pointer-events: auto;
+  appearance: none;
+  border: 1px solid var(--ui-line);
+  background: rgba(255, 255, 255, 0.04);
+  color: var(--ui-text);
+  font: inherit;
+  font-size: 15px;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  padding: 13px 22px;
+  cursor: pointer;
+  transition: background 0.13s, border-color 0.13s, transform 0.09s;
+  text-align: left;
+}
+.btn:hover {
+  background: var(--ui-accent-dim);
+  border-color: var(--ui-accent);
+}
+.btn:active { transform: translateY(1px); }
+.btn--primary {
+  background: var(--ui-accent);
+  border-color: var(--ui-accent);
+  color: #171008;
+  font-weight: 700;
+}
+.btn--primary:hover { filter: brightness(1.1); background: var(--ui-accent); }
+.btn--ghost { background: none; }
+.btn--danger:hover { border-color: var(--ui-danger); background: rgba(216, 87, 75, 0.16); }
+.btn--small { padding: 8px 14px; font-size: 12px; }
+.btn--active { border-color: var(--ui-accent); background: var(--ui-accent-dim); }
+
+.btn-column { display: flex; flex-direction: column; gap: 10px; width: 280px; }
+.btn-row { display: flex; gap: 10px; flex-wrap: wrap; }
+
+/* ---------- panels -------------------------------------------------------- */
+
+.panel {
+  background: var(--ui-panel);
+  border: 1px solid var(--ui-line);
+  padding: 26px 28px;
+}
+.panel--tight { padding: 16px 18px; }
+
+/* ---------- main menu ----------------------------------------------------- */
+
+.main-menu__layout { display: flex; gap: 40px; align-items: flex-start; }
+.main-menu__brand { flex: 1; }
+.main-menu__version {
+  color: var(--ui-dim);
+  font-family: var(--ui-mono);
+  font-size: 11px;
+  margin-top: 6px;
+}
+
+.level-list { display: flex; flex-direction: column; gap: 10px; min-width: 340px; }
+.level-card {
+  pointer-events: auto;
+  border: 1px solid var(--ui-line);
+  background: rgba(255, 255, 255, 0.03);
+  padding: 14px 16px;
+  cursor: pointer;
+  text-align: left;
+  color: inherit;
+  font: inherit;
+  transition: background 0.13s, border-color 0.13s;
+}
+.level-card:hover { border-color: var(--ui-accent); background: var(--ui-accent-dim); }
+.level-card__name {
+  font-size: 16px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
+}
+.level-card__desc { color: var(--ui-dim); font-size: 13px; margin-top: 4px; }
+
+/* ---------- loading ------------------------------------------------------- */
+
+.loading__bar {
+  width: min(520px, 80vw);
+  height: 6px;
+  background: rgba(255, 255, 255, 0.10);
+  overflow: hidden;
+}
+.loading__fill {
+  height: 100%;
+  width: 0%;
+  background: var(--ui-accent);
+  transition: width 0.18s linear;
+}
+.loading__pct { font-family: var(--ui-mono); color: var(--ui-dim); font-size: 12px; }
+.loading__prompt {
+  font-size: clamp(18px, 2.4vw, 26px);
+  letter-spacing: 0.24em;
+  text-transform: uppercase;
+  animation: pulse 1.5s ease-in-out infinite;
+}
+@keyframes pulse { 0%, 100% { opacity: 0.55; } 50% { opacity: 1; } }
+
+/* ---------- settings ------------------------------------------------------ */
+
+.tabs { display: flex; gap: 6px; border-bottom: 1px solid var(--ui-line); }
+.tab {
+  pointer-events: auto; appearance: none; border: none; background: none;
+  color: var(--ui-dim); font: inherit; font-size: 13px; letter-spacing: 0.16em;
+  text-transform: uppercase; padding: 10px 16px; cursor: pointer;
+  border-bottom: 2px solid transparent;
+}
+.tab:hover { color: var(--ui-text); }
+.tab--active { color: var(--ui-accent); border-bottom-color: var(--ui-accent); }
+
+.tab-body { display: none; padding-top: 18px; }
+.tab-body--active { display: block; }
+
+.field { display: flex; align-items: center; gap: 16px; padding: 9px 0; }
+.field__label { width: 200px; color: var(--ui-dim); font-size: 14px; }
+.field__control { flex: 1; display: flex; align-items: center; gap: 12px; }
+.field__value { font-family: var(--ui-mono); font-size: 12px; width: 56px; text-align: right; }
+
+input[type='range'] { pointer-events: auto; flex: 1; accent-color: var(--ui-accent); }
+input[type='checkbox'] { pointer-events: auto; width: 17px; height: 17px; accent-color: var(--ui-accent); }
+
+.binding-list { max-height: 46vh; overflow-y: auto; padding-right: 8px; }
+.binding {
+  display: flex; align-items: center; justify-content: space-between;
+  padding: 7px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.06);
+}
+.binding__name { font-size: 14px; }
+.binding__key {
+  pointer-events: auto; font-family: var(--ui-mono); font-size: 12px;
+  min-width: 130px; text-align: center; padding: 7px 10px;
+  border: 1px solid var(--ui-line); background: rgba(255, 255, 255, 0.04);
+  color: var(--ui-text); cursor: pointer;
+}
+.binding__key:hover { border-color: var(--ui-accent); }
+.binding__key--listening {
+  border-color: var(--ui-accent); color: var(--ui-accent);
+  animation: pulse 0.9s ease-in-out infinite;
+}
+
+/* ---------- loadout ------------------------------------------------------- */
+
+.loadout__grid { display: grid; grid-template-columns: 1fr 1fr 340px; gap: 22px; }
+.loadout__preview {
+  border: 1px solid var(--ui-line); background: #0e1115;
+  aspect-ratio: 1 / 1; position: relative; overflow: hidden;
+}
+.loadout__preview canvas { width: 100% !important; height: 100% !important; display: block; }
+.skin-row { display: flex; gap: 8px; margin-top: 10px; }
+.skin-swatch {
+  pointer-events: auto; width: 34px; height: 34px; cursor: pointer;
+  border: 2px solid transparent; outline: 1px solid var(--ui-line);
+}
+.skin-swatch--active { border-color: var(--ui-accent); }
+
+/* ---------- game over ----------------------------------------------------- */
+
+.stat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
+.stat { border-left: 2px solid var(--ui-accent); padding-left: 12px; }
+.stat__value { font-size: 30px; font-weight: 700; font-family: var(--ui-mono); }
+.stat__label {
+  font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ui-dim);
+}
+
+/* ---------- HUD ----------------------------------------------------------- */
+
+.hud { position: absolute; inset: 0; pointer-events: none; display: none; }
+.hud--active { display: block; }
+
+.hud__health {
+  position: absolute; left: 34px; bottom: 34px; width: 240px;
+}
+.hud__health-bar {
+  height: 7px; background: rgba(255, 255, 255, 0.13); overflow: hidden; margin-top: 6px;
+}
+.hud__health-fill {
+  height: 100%; width: 100%; background: var(--ui-good);
+  transform-origin: left center; transition: background 0.2s;
+}
+.hud__health-num { font-family: var(--ui-mono); font-size: 25px; font-weight: 700; }
+.hud__label {
+  font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ui-dim);
+}
+
+.hud__ammo { position: absolute; right: 34px; bottom: 30px; text-align: right; }
+.hud__ammo-mag { font-family: var(--ui-mono); font-size: 42px; font-weight: 700; line-height: 1; }
+.hud__ammo-reserve { font-family: var(--ui-mono); font-size: 18px; color: var(--ui-dim); }
+.hud__ammo-name {
+  font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
+  color: var(--ui-dim); margin-top: 5px;
+}
+.hud__ammo--empty .hud__ammo-mag { color: var(--ui-danger); }
+
+/* Crosshair: four segments that move outward as real spread grows.
+   Each segment is absolutely positioned about the centre point, so BOTH axes
+   must be pinned — setting only `top` (or only `left`) leaves the other axis
+   at its default and the arm drifts into a corner. */
+.hud__crosshair {
+  position: absolute; left: 50%; top: 50%; width: 0; height: 0;
+}
+.hud__ch-seg {
+  position: absolute;
+  background: rgba(255, 255, 255, 0.92);
+  box-shadow: 0 0 2px rgba(0, 0, 0, 0.9);
+}
+.hud__ch-seg--v { width: 2px; height: 8px; left: -1px; }
+.hud__ch-seg--h { height: 2px; width: 8px; top: -1px; }
+.hud__ch-dot {
+  position: absolute; width: 2px; height: 2px; left: -1px; top: -1px;
+  background: rgba(255, 255, 255, 0.9);
+  box-shadow: 0 0 2px rgba(0, 0, 0, 0.9);
+}
+
+.hud__hitmarker {
+  position: absolute; left: 50%; top: 50%; width: 22px; height: 22px;
+  margin: -11px 0 0 -11px; opacity: 0;
+}
+.hud__hitmarker svg { width: 100%; height: 100%; }
+.hud__hitmarker--show { opacity: 1; }
+.hud__hitmarker--kill svg line { stroke: var(--ui-danger) !important; }
+
+.hud__damage-dir {
+  position: absolute; left: 50%; top: 50%;
+  width: 0; height: 0; opacity: 0; transition: opacity 0.25s;
+}
+.hud__damage-dir-wedge {
+  position: absolute; left: -46px; top: -150px; width: 92px; height: 44px;
+  background: linear-gradient(to top, rgba(216, 87, 75, 0), rgba(216, 87, 75, 0.85));
+  clip-path: polygon(50% 0%, 100% 100%, 0% 100%);
+}
+
+.hud__vignette {
+  position: absolute; inset: 0; opacity: 0; pointer-events: none;
+  background: radial-gradient(ellipse at center,
+    rgba(160, 20, 20, 0) 42%, rgba(150, 16, 16, 0.85) 100%);
+  transition: opacity 0.25s;
+}
+.hud__vignette--pulse { animation: vignette-pulse 1.15s ease-in-out infinite; }
+@keyframes vignette-pulse { 0%, 100% { filter: brightness(0.85); } 50% { filter: brightness(1.3); } }
+
+.hud__hint {
+  position: absolute; left: 50%; bottom: 92px; transform: translateX(-50%);
+  font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ui-dim);
+}
+
+/* ---------- killstreak HUD (Document H §3 / Document J §1.3) -------------- */
+
+/* Hidden by default; .hud--active only during PLAYING, exactly like .hud.
+   A HUD element must never paint over a menu. */
+.hud__killstreaks {
+  position: absolute; left: 28px; top: 28px;
+  display: none; flex-direction: column; gap: 7px;
+  pointer-events: none;
+}
+.hud__killstreaks.hud--active { display: flex; }
+
+.ks-slot {
+  position: relative;
+  display: flex; align-items: center; gap: 10px;
+  width: 214px; padding: 8px 34px 8px 10px;
+  border-left: 3px solid rgba(255, 255, 255, 0.18);
+  background: linear-gradient(
+    90deg, rgba(10, 13, 18, 0.80) 0%, rgba(10, 13, 18, 0.42) 100%);
+  transition: border-color 0.18s, opacity 0.18s, transform 0.12s;
+}
+
+/* Icon plate: the glyph is a MASK, so a single white PNG tints per state. */
+.ks-slot__plate {
+  position: relative; flex: 0 0 auto;
+  width: 38px; height: 38px;
+  display: grid; place-items: center;
+}
+.ks-slot__ring {
+  position: absolute; inset: -3px; border-radius: 50%;
+  /* conic-gradient set per-frame while active/cooling */
+  -webkit-mask: radial-gradient(farthest-side, transparent 76%, #000 78%);
+  mask: radial-gradient(farthest-side, transparent 76%, #000 78%);
+}
+.ks-slot__icon {
+  width: 30px; height: 30px;
+  background: var(--ui-dim);
+  -webkit-mask-size: contain; mask-size: contain;
+  -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
+  -webkit-mask-position: center; mask-position: center;
+  transition: background 0.18s;
+}
+
+.ks-slot__body { flex: 1 1 auto; min-width: 0; }
+.ks-slot__label {
+  font-size: 11px; font-weight: 700; letter-spacing: 0.14em;
+  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
+  color: var(--ui-text);
+}
+.ks-slot__status {
+  font: 600 10px/1.5 var(--ui-mono);
+  letter-spacing: 0.14em; color: var(--ui-dim);
+}
+.ks-slot__bar {
+  margin-top: 3px; height: 2px; overflow: hidden;
+  background: rgba(255, 255, 255, 0.12);
+}
+.ks-slot__fill {
+  height: 100%; width: 100%; transform-origin: left center;
+  background: var(--ui-dim); transition: transform 0.15s linear;
+}
+.ks-slot__key {
+  position: absolute; right: 8px; top: 7px;
+  font: 700 9px/1 var(--ui-mono); color: var(--ui-dim);
+  border: 1px solid var(--ui-line); border-radius: 2px;
+  padding: 2px 4px;
+}
+
+/* --- states --------------------------------------------------------------- */
+.ks-slot--locked { opacity: 0.38; }
+.ks-slot--locked .ks-slot__icon { background: var(--ui-dim); }
+
+.ks-slot--ready {
+  border-left-color: var(--ui-accent);
+  background: linear-gradient(
+    90deg, rgba(240, 160, 75, 0.24) 0%, rgba(10, 13, 18, 0.42) 100%);
+  animation: ks-ready 1.9s ease-in-out infinite;
+}
+.ks-slot--ready .ks-slot__icon { background: var(--ui-accent); }
+.ks-slot--ready .ks-slot__status { color: var(--ui-accent); }
+.ks-slot--ready .ks-slot__fill { background: var(--ui-accent); }
+.ks-slot--ready .ks-slot__key { color: var(--ui-accent); border-color: var(--ui-accent); }
+
+.ks-slot--active { border-left-color: var(--ui-good); }
+.ks-slot--active .ks-slot__icon { background: var(--ui-good); }
+.ks-slot--active .ks-slot__status { color: var(--ui-good); }
+.ks-slot--active .ks-slot__fill { background: var(--ui-good); }
+
+.ks-slot--cooling { opacity: 0.66; border-left-color: #6d8fb8; }
+.ks-slot--cooling .ks-slot__icon { background: #6d8fb8; }
+.ks-slot--cooling .ks-slot__fill { background: #6d8fb8; }
+
+@keyframes ks-ready {
+  0%, 100% { box-shadow: inset 2px 0 0 rgba(240, 160, 75, 0.0); }
+  50% { box-shadow: inset 2px 0 0 rgba(240, 160, 75, 0.55); }
+}
+
+/* ---------- equipment HUD + disorient overlays (Document F §7) ------------ */
+
+.hud__equipment {
+  position: absolute; right: 34px; bottom: 118px;
+  display: none; flex-direction: column; align-items: flex-end; gap: 3px;
+  pointer-events: none;
+}
+.hud__equipment.hud--active { display: flex; }
+.hud__equipment--empty { opacity: 0.4; }
+.eq__row { display: flex; align-items: baseline; gap: 8px; }
+.eq__label {
+  font-size: 13px; font-weight: 700; letter-spacing: 0.16em;
+}
+.eq__count { font: 700 17px/1 var(--ui-mono); color: var(--ui-text); }
+.eq__key {
+  font: 600 10px/1 var(--ui-mono); color: var(--ui-dim);
+  border: 1px solid var(--ui-line); padding: 2px 5px;
+}
+.eq__cook {
+  width: 74px; height: 3px; margin-top: 3px; opacity: 0;
+  background: rgba(255, 255, 255, 0.14); transition: opacity 0.1s;
+}
+.eq__cook-fill {
+  height: 100%; width: 100%; transform: scaleX(0);
+  transform-origin: left center; background: var(--ui-accent);
+}
+
+/* Three independent layers — they stack by ordinary CSS compositing, so
+   being flashed inside your own smoke needs no combination code. */
+.hud__disorient { position: absolute; inset: 0; display: none; pointer-events: none; }
+.hud__disorient.hud--active { display: block; }
+.overlay-flash {
+  position: absolute; inset: 0; background: #ffffff; opacity: 0;
+  pointer-events: none;
+}
+.overlay-concussion {
+  position: absolute; inset: 0; opacity: 0; pointer-events: none;
+  background: rgba(190, 205, 225, 0.10);
+  transition: opacity 0.25s linear;
+}
+.overlay-smoke {
+  position: absolute; inset: 0; opacity: 0; pointer-events: none;
+  background: radial-gradient(ellipse at center,
+    rgba(198, 200, 205, 0.55) 0%, rgba(186, 190, 196, 0.88) 100%);
+  transition: opacity 0.3s linear;
+}
+
+/* ---------- minimap + compass (Document I §3.2) --------------------------- */
+
+.hud__minimap {
+  position: absolute; right: 34px; top: 34px;
+  display: none; flex-direction: column; gap: 4px;
+  pointer-events: none;
+}
+.hud__minimap.hud--active { display: flex; }
+.hud__minimap canvas { display: block; }
+.hud__compass { border: 1px solid var(--ui-line); }
+
+/* ---------- missile cam + cinematic bars (Document I §6.4/§6.7) ----------- */
+
+.cinematic-bars { position: absolute; inset: 0; pointer-events: none; }
+.cinematic-bars__top, .cinematic-bars__bottom {
+  position: absolute; left: 0; right: 0; height: 11vh;
+  background: #000; transform: scaleY(0); transition: transform 0.45s ease;
+}
+.cinematic-bars__top { top: 0; transform-origin: top center; }
+.cinematic-bars__bottom { bottom: 0; transform-origin: bottom center; }
+.cinematic-bars--in .cinematic-bars__top,
+.cinematic-bars--in .cinematic-bars__bottom { transform: scaleY(1); }
+
+.hud__missile { position: absolute; inset: 0; display: none; pointer-events: none; }
+.hud__missile.hud--active { display: block; }
+
+/* Scanline wash — cheap, and it reads instantly as "camera feed". */
+.missile__scanlines {
+  position: absolute; inset: 0; opacity: 0.5;
+  background: repeating-linear-gradient(
+    to bottom, rgba(0,0,0,0) 0 2px, rgba(0,0,0,0.30) 2px 4px);
+}
+
+.missile__reticle {
+  position: absolute; left: 50%; top: 50%;
+  width: 180px; height: 180px; margin: -90px 0 0 -90px;
+}
+.missile__bracket {
+  position: absolute; width: 26px; height: 26px;
+  border-color: rgba(120, 255, 190, 0.9); border-style: solid; border-width: 0;
+}
+.missile__bracket--tl { left: 0; top: 0; border-left-width: 2px; border-top-width: 2px; }
+.missile__bracket--tr { right: 0; top: 0; border-right-width: 2px; border-top-width: 2px; }
+.missile__bracket--bl { left: 0; bottom: 0; border-left-width: 2px; border-bottom-width: 2px; }
+.missile__bracket--br { right: 0; bottom: 0; border-right-width: 2px; border-bottom-width: 2px; }
+
+.missile__horizon {
+  position: absolute; left: 12%; right: 12%; top: 50%; height: 1px;
+  background: rgba(120, 255, 190, 0.35);
+}
+
+.missile__fuel {
+  position: absolute; left: 50%; bottom: 16vh; transform: translateX(-50%);
+  width: 210px;
+}
+.missile__fuel-label {
+  font: 600 9px/1.6 var(--ui-mono); letter-spacing: 0.22em;
+  color: rgba(120, 255, 190, 0.75);
+}
+.missile__fuel-fill {
+  height: 3px; width: 100%; transform-origin: left center;
+  background: rgba(120, 255, 190, 0.9); transition: transform 0.1s linear;
+}
+.missile__fuel-fill--low { background: var(--ui-danger); animation: ks-ready 0.5s infinite; }
+
+.missile__status {
+  position: absolute; left: 50%; bottom: 13vh; transform: translateX(-50%);
+  font: 600 10px/1 var(--ui-mono); letter-spacing: 0.2em;
+  color: rgba(120, 255, 190, 0.8);
+}
+.missile__status--warn { color: var(--ui-danger); }
+
+/* Any HUD layer can be suppressed for a cinematic without losing its own
+   PLAYING-state gating — the two rules compose rather than fight. */
+.hud--suppressed { display: none !important; }
+
