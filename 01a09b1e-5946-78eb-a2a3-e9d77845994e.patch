+  const RESAMPLE_HZ = 60;
+  if (times.length < 2) {
+    return new THREE.QuaternionKeyframeTrack(`${node}.quaternion`, [...times], quats.flat());
+  }
+  const start = times[0];
+  const end = times[times.length - 1];
+  const count = Math.max(2, Math.ceil((end - start) * RESAMPLE_HZ) + 1);
