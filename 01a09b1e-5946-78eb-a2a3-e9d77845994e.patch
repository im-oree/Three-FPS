+  root.add(socket('Socket_Ejection', [0.040, 0.028, -0.02]));
+  // Rear of the eyepiece: the eye-relief anchor for the scope.
+  root.add(socket('Socket_Optic', [0, 0.078, 0.035]));
+
+  validateSockets(root);
+  return root;
+}
