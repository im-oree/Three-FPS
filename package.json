{
  "name": "operator-fps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OPERATOR \u2014 a Call of Duty-style 3D first-person shooter built on Three.js + Vite (Document 1: foundation & core engine).",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/copyAssets.mjs",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "backend": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "verify:setup": "bash tools/verify/bootstrap.sh",
    "verify:probe": "node tools/verify/probe-webgl.mjs",
    "verify": "node tools/verify/verify.mjs",
    "verify:acceptance": "node tools/verify/acceptance-doc2.mjs",
    "verify:acceptance:doc1": "node tools/verify/acceptance-doc1.mjs",
    "verify:acceptance:doc2": "node tools/verify/acceptance-doc2.mjs",
    "verify:acceptance:docc": "node tools/verify/acceptance-docc.mjs",
    "verify:acceptance:docd": "node tools/verify/acceptance-docd.mjs",
    "verify:acceptance:tps": "node tools/verify/acceptance-tps.mjs",
    "verify:state": "node tools/verify/state-authority.mjs",
    "generate:audio": "node tools/generateAudio.mjs",
    "verify:acceptance:doc5": "node tools/verify/acceptance-doc5.mjs",
    "generate:skins": "node tools/generateSkinTextures.js",
    "validate:weapons": "node tools/validateWeaponModel.js --all",
    "generate:vehicles": "node tools/generateVehicleModels.js",
    "generate:fleet": "node tools/generateVehicleFleet.js",
    "verify:meshkit": "node tools/verify/meshkit-test.mjs",
    "generate:explosionfx": "node tools/generateExplosionTextures.js",
    "generate:icons": "node tools/generateKillstreakIcons.js",
    "generate:firingrange:props": "node tools/generateFiringRangeProps.js",
    "generate:firingrange:shell": "node tools/generateFiringRangeShell.js",
    "generate:firingrange:manifest": "node tools/generateFiringRangeManifest.js",
    "generate:firingrange": "npm run generate:firingrange:props && npm run generate:firingrange:shell && npm run generate:firingrange:manifest",
    "validate:cinematics": "node tools/verify/validate-cinematics.mjs",
    "verify:acceptance:docn": "node tools/verify/acceptance-docn.mjs",
    "verify:shots:docn": "node tools/verify/docn-shots.mjs",
    "verify:gunship": "node tools/verify/acceptance-gunship.mjs",
    "verify:purity": "node tools/verify/server-purity.mjs",
    "verify:server": "node tools/verify/server-core.mjs",
    "verify:session": "node tools/verify/acceptance-session.mjs",
    "verify:backend": "node tools/verify/backend-smoke.mjs",
    "verify:movement": "node tools/verify/server-movement.mjs",
    "bake:collision": "node tools/bakeCollision.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "simplex-noise": "^4.0.3",
    "three": "0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "@types/three": "0.170.0",
    "puppeteer-core": "25.10.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
